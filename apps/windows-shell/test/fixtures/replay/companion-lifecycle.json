{
  "name": "companion lifecycle: IPC actions, test-mode start refusal, status routing per backend, bubbles",
  "companion": { "backend": "claude", "connected": false },
  "steps": [
    { "do": "ipc", "channel": "ccf:companion-action", "args": [ { "action": "start" } ], "rejects": "disabled in test mode" },
    { "do": "post", "route": "/companion/open", "body": {}, "expect": { "status": 503, "body": { "error": "Claude Code start is disabled in test mode." } } },
    { "do": "calls", "expect": [] },
    { "do": "ipc", "channel": "ccf:companion-action", "args": [ { "action": "select-backend", "backend": "codex" } ], "expect": { "ok": true } },
    { "do": "ipc", "channel": "ccf:companion-action", "args": [ { "action": "select-backend", "backend": "copilot" } ], "rejects": "Unsupported companion backend" },
    { "do": "ipc", "channel": "ccf:companion-action", "args": [ { "action": "switch-backend", "backend": "claude" } ], "rejects": "Explicit switch required" },
    { "do": "ipc", "channel": "ccf:companion-action", "args": [ { "action": "switch-backend", "backend": "claude", "userInitiated": true } ], "expect": { "ok": true } },
    { "do": "calls", "expect": [
      { "method": "selectBackend", "args": [ "codex" ] },
      { "method": "selectBackend", "args": [ "copilot" ] },
      { "method": "switchBackend", "args": [ { "backend": "claude", "userInitiated": false } ] },
      { "method": "switchBackend", "args": [ { "backend": "claude", "userInitiated": true } ] } ] },

    { "do": "ipc", "channel": "ccf:companion-action", "args": [ { "action": "send", "submissionId": "in-1", "text": "hi", "attachmentIds": [ "img-1" ], "draftRevision": 3 } ],
      "expect": { "ok": true, "submission": { "id": "in-1", "state": "accepted" } } },
    { "do": "calls", "expect": [
      { "method": "submit", "args": [ { "id": "in-1", "text": "hi", "attachments": [ { "id": "img-1" } ], "draftRevision": 3 } ] },
      { "method": "attachments.markSent", "args": [ [ "img-1" ] ] } ] },
    { "do": "ipc", "channel": "ccf:companion-action", "args": [ { "action": "resolve-request", "key": "k-1", "response": { "decision": "accept" } } ], "expect": { "ok": true } },
    { "do": "ipc", "channel": "ccf:companion-action", "args": [ { "action": "resolve-unknown", "submissionId": "in-0", "disposition": "abandon" } ], "expect": { "ok": true } },
    { "do": "ipc", "channel": "ccf:companion-action", "args": [ { "action": "history", "before": null } ], "expect": { "ok": true, "items": [ { "id": "h-1" } ] } },
    { "do": "ipc", "channel": "ccf:companion-action", "args": [ { "action": "read-output", "itemId": "item-1" } ], "expect": { "ok": true, "output": "output" } },
    { "do": "ipc", "channel": "ccf:companion-action", "args": [ { "action": "raw-input", "text": "\r" } ], "expect": { "ok": true } },
    { "do": "ipc", "channel": "ccf:companion-action", "args": [ { "action": "resize", "cols": 80, "rows": 24 } ], "expect": { "ok": true } },
    { "do": "ipc", "channel": "ccf:companion-action", "args": [ { "action": "interrupt" } ], "expect": { "ok": true } },
    { "do": "ipc", "channel": "ccf:companion-action", "args": [ { "action": "stop" } ], "expect": { "ok": true } },
    { "do": "ipc", "channel": "ccf:companion-action", "args": [ { "action": "end-day" } ], "expect": { "ok": true } },
    { "do": "ipc", "channel": "ccf:companion-action", "args": [ { "action": "recover-launch", "retainUnknown": true } ], "expect": { "ok": true } },
    { "do": "ipc", "channel": "ccf:companion-action", "args": [ { "action": "explode" } ], "rejects": "Unsupported companion action" },
    { "do": "calls", "expect": [
      { "method": "resolveRequest", "args": [ { "key": "k-1", "response": { "decision": "accept" } } ] },
      { "method": "resolveUnknown", "args": [ { "action": "resolve-unknown", "submissionId": "in-0", "disposition": "abandon" } ] },
      { "method": "history", "args": [ { "action": "history", "before": null } ] },
      { "method": "getOutput", "args": [ { "itemId": "item-1" } ] },
      { "method": "write", "args": [ "\r", { "ptyId": null } ] },
      { "method": "resize", "args": [ 80, 24 ] },
      { "method": "interrupt", "args": [] },
      { "method": "stop", "args": [] },
      { "method": "stop", "args": [ { "disposition": "day-end" } ] },
      { "method": "recoverFailedStart", "args": [ { "userInitiated": true, "retainUnknown": true } ] } ] },
    { "do": "ipc", "channel": "ccf:get-companion", "args": [], "expect": { "backend": "codex", "attachments": [], "debugUi": false } },

    { "do": "post", "route": "/companion/status", "body": { "session_id": "c-ignored", "cwd": "$COMPANION" }, "expect": { "status": 200 } },
    { "do": "ipc", "channel": "ccf:get-companion-status", "args": [], "expect": null },
    { "do": "ipc", "channel": "ccf:companion-action", "args": [ { "action": "select-backend", "backend": "claude" } ], "expect": { "ok": true } },
    { "do": "post", "route": "/companion/status", "body": { "session_id": "c-1", "cwd": "$COMPANION", "model": { "display_name": "Claude" } }, "expect": { "status": 200 } },
    { "do": "post", "route": "/companion/status", "body": { "session_id": "c-elsewhere", "cwd": "$OTHER" }, "expect": { "status": 200 } },
    { "do": "post", "route": "/companion/status", "body": { "session_id": "c-codex", "cwd": "$COMPANION", "backend": "codex" }, "expect": { "status": 200 } },
    { "do": "ipc", "channel": "ccf:get-companion-status", "args": [], "expect": { "session_id": "c-1", "model": { "display_name": "Claude" } } },
    { "do": "companionChange", "snapshot": { "backend": "codex", "connected": true, "phase": "idle", "conversationId": "t-1",
      "environment": { "model": "gpt-fixture" }, "usage": { "tokens": { "last": { "totalTokens": 500 }, "modelContextWindow": 1000 } } } },
    { "do": "ipc", "channel": "ccf:get-companion-status", "args": [], "expect": { "backend": "codex", "session_id": "t-1", "model": { "display_name": "gpt-fixture" },
      "context_window": { "context_window_size": 1000, "total_input_tokens": 500, "used_percentage": 50 }, "cost": null } },
    { "do": "companionChange", "snapshot": { "backend": "claude", "connected": false, "phase": "offline", "conversationId": null } },
    { "do": "ipc", "channel": "ccf:get-companion-status", "args": [], "expect": null },

    { "do": "post", "route": "/companion/bubble", "body": { "event": "agent_idle", "placeholders": { "agent": "temp" } },
      "expect": { "status": 200, "body": { "ok": true, "shown": true, "tier": "common", "kind": "line", "text": "Idle again" } } },
    { "do": "post", "route": "/companion/bubble", "body": { "text": "Free text" }, "expect": { "status": 200, "body": { "ok": true, "shown": true } } },
    { "do": "post", "route": "/companion/bubble", "body": { "event": "no_such_line" }, "expect": { "status": 400, "body": { "error": "unknown_bubble_event" } } },
    { "do": "ipc", "channel": "ccf:get-companion-bubbles", "args": [], "expect": [ { "text": "Idle again" }, { "text": "Free text" } ] },
    { "do": "sent", "window": "bubble", "channel": "ccf:companion-bubbles", "expectLast": [ { "text": "Idle again" }, { "text": "Free text" } ] },
    { "do": "calls", "expect": [ { "method": "selectBackend", "args": [ "claude" ] } ] }
  ]
}
